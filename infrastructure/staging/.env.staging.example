# Gate 5 staging config template — copy to `.env.staging` and fill ISOLATED values.
# NEVER reuse production secrets or credentials here. .env.staging is gitignored.

ENVIRONMENT=staging

# Strong, staging-only random values (generate fresh — do NOT copy from prod):
SECRET_KEY=
JWT_SECRET=

# DB password used by docker-compose (db service + DATABASE_URL). Compose builds
# the container DATABASE_URL from this; you normally don't set DATABASE_URL here.
STAGING_DB_PASSWORD=staging_pw

# Frontend origin(s) allowed to call the staging API.
ALLOWED_ORIGINS=http://localhost:5173

# AI providers: leave EMPTY to exercise the deterministic offline path under load,
# or set a dedicated STAGING Gemini key (never the production key) to load-test the
# real provider path + rotation.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
CLAUDE_API_KEY=

# Optional: enable the response cache under load to measure hit ratio.
AI_RESPONSE_CACHE_TTL_SECONDS=0

# SMS / email stay dormant in staging.
AT_API_KEY=
AT_USERNAME=
AT_ENVIRONMENT=sandbox
EMAIL_PROVIDER=console
